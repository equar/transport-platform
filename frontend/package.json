{
  "name": "transport-platform-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode public",
    "build": "tsc -b && npm run clean:build && npm run build:public && npm run build:admin && npm run check:sites",
    "preview": "vite preview --mode public --outDir dist/public",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "dev:admin": "vite --mode admin",
    "build:public": "vite build --mode public --outDir dist/public",
    "build:admin": "vite build --mode admin --outDir dist/admin",
    "preview:admin": "vite preview --mode admin --outDir dist/admin",
    "check:sites": "node scripts/check-site-build.mjs",
    "clean:build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.8",
    "@mui/material": "^6.4.8",
    "axios": "^1.20.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.4",
    "vitest": "^4.1.12"
  }
}
