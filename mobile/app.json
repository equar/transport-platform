{
  "expo": {
    "name": "Transport Platform",
    "slug": "transport-platform-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "transport",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f4c5c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.transportplatform.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Upload compliance documents.",
        "NSLocationWhenInUseUsageDescription": "Show your location on the route map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Share driver location during an active trip. Tracking stops after drop-off or sign-out.",
        "NSPhotoLibraryUsageDescription": "Pick a document to upload.",
        "UIBackgroundModes": [
          "location"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0f4c5c"
      },
      "package": "com.transportplatform.mobile",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#0f4c5c"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Share driver location during an active trip. Tracking stops after drop-off or sign-out.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Take a photo of a compliance document when you choose to upload one.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://transport.bakaroo.com/api",
      "eas": {
        "projectId": "80182d4a-8191-4f8c-9d44-7937ad4d94c2"
      }
    }
  }
}
