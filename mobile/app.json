{
  "expo": {
    "name": "Transport Platform",
    "slug": "transport-platform-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "transport",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f4c5c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.transportplatform.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Upload compliance documents.",
        "NSLocationWhenInUseUsageDescription": "Show your location on the route map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Track your active route.",
        "NSPhotoLibraryUsageDescription": "Pick a document to upload."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f4c5c"
      },
      "package": "com.transportplatform.mobile",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "androidStatusBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#ffffff",
      "barStyle": "dark-content"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0f4c5c"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Transport Platform to use your location."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://transport.bakaroo.com/api",
      "eas": {
        "projectId": "80182d4a-8191-4f8c-9d44-7937ad4d94c2"
      }
    }
  }
}
