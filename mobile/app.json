{
  "expo": {
    "name": "Bakaroo Transports",
    "slug": "transport-platform-mobile",
    "version": "1.0.0",
    "scheme": "transport",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f4c5c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.transportplatform.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Upload compliance documents.",
        "NSLocationWhenInUseUsageDescription": "Show your location on the route map.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Track your active route.",
        "NSPhotoLibraryUsageDescription": "Pick a document to upload."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#0f4c5c"
      },
      "package": "com.transportplatform.mobile",
      "versionCode": 1,
      "allowBackup": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#0f4c5c"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Bakaroo Transports to use your location."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 24,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          },
          "ios": {
            "deploymentTarget": "15.1",
            "networkInspector": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://transport.bakaroo.com/api",
      "eas": {
        "projectId": "replace-with-eas-project-id"
      }
    }
  }
}
