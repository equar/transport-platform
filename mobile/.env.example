# Simulator/emulator defaults are selected by the install scripts.
# Set this explicitly for physical devices using your computer's LAN address.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:8082/api

# Optional local-only prefill for login form. Leave empty in shared environments.

# Optional native maps SDK key (never committed with a real production secret).
GOOGLE_MAPS_API_KEY=

# Push notifications
EXPO_PUBLIC_EAS_PROJECT_ID=80182d4a-8191-4f8c-9d44-7937ad4d94c2
# Optional explicit alias for the same Expo project ID.
EXPO_PUBLIC_EXPO_PROJECT_ID=80182d4a-8191-4f8c-9d44-7937ad4d94c2
# Optional Android Firebase file location for native push support.
# EXPO_ANDROID_GOOGLE_SERVICES_FILE=./google-services.json

# Required only for physical iOS device signing.
DEVELOPMENT_TEAM=YOUR_TEAM_ID

# Optional when more than one device is connected.
ANDROID_SERIAL=
IOS_DEVICE_UDID=
