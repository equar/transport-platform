{
  "name": "transport-platform-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "expo:android": "expo start --android",
    "expo:ios": "expo start --ios",
    "web": "expo start --web",
    "setup:check": "./scripts/setup-android.sh --check && ./scripts/setup-ios.sh --check",
    "setup:android": "./scripts/setup-android.sh",
    "setup:ios": "./scripts/setup-ios.sh",
    "android": "./scripts/install-android.sh --emulator",
    "android:dev": "./scripts/install-android.sh --emulator --dev",
    "android:prod": "./scripts/install-android.sh --emulator --prod",
    "android:device": "./scripts/install-android.sh --device",
    "android:device:dev": "./scripts/install-android.sh --device --dev",
    "android:device:prod": "./scripts/install-android.sh --device --prod",
    "android:release": "./scripts/install-android-release.sh",
    "ios": "./scripts/install-ios-simulator.sh",
    "ios:dev": "./scripts/install-ios-simulator.sh --dev",
    "ios:prod": "./scripts/install-ios-simulator.sh --prod",
    "ios:simulator": "./scripts/install-ios-simulator.sh",
    "ios:device": "./scripts/install-ios-device.sh",
    "ios:device:dev": "./scripts/install-ios-device.sh --dev",
    "ios:device:prod": "./scripts/install-ios-device.sh --prod",
    "test": "jest --watchAll",
    "test:ci": "jest --runInBand",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "upgrade:check": "CI=1 npx expo install --check",
    "security:audit": "npm audit"
  },
  "dependencies": {
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.61.0",
    "axios": "^1.20.0",
    "expo": "^57.0.19",
    "expo-asset": "~57.0.16",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.3",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.4",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.15",
    "expo-notifications": "~57.0.16",
    "expo-router": "~57.0.18",
    "expo-secure-store": "~57.0.3",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-maps": "1.27.2",
    "react-native-paper": "^5.12.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  }
}
