{
  "name": "transport-platform-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "android": "bash ./scripts/install-android.sh --emulator",
    "android:device": "bash ./scripts/install-android.sh --device",
    "android:release": "bash ./scripts/install-android-release.sh",
    "ios": "bash ./scripts/install-ios-simulator.sh",
    "ios:device": "bash ./scripts/install-ios-device.sh",
    "start": "expo start --dev-client",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "setup:ios": "bash ./scripts/setup-ios.sh",
    "setup:android": "bash ./scripts/setup-android.sh",
    "setup:all": "npm run setup:ios && npm run setup:android",
    "setup:check": "bash ./scripts/setup-ios.sh --check && bash ./scripts/setup-android.sh --check"
  },
  "dependencies": {
