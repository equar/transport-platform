    "@react-navigation/native-stack": "^7.2.0",
    "@sentry/react-native": "~7.2.0",
    "@tanstack/react-query": "^5.90.20",
    "ajv": "^8.20.0",
    "axios": "^1.7.9",
    "expo": "^54.0.33",
    "expo-build-properties": "~1.0.10",
