{
  "name": "transport-platform-mobile",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "expo:android": "expo start --android",
    "expo:ios": "expo start --ios",
    "web": "expo start --web",
    "setup:check": "./scripts/setup-android.sh --check && ./scripts/setup-ios.sh --check",
    "setup:android": "./scripts/setup-android.sh",
    "setup:ios": "./scripts/setup-ios.sh",
    "android": "./scripts/install-android.sh --emulator",
    "android:device": "./scripts/install-android.sh --device",
    "android:release": "./scripts/install-android-release.sh",
    "ios": "./scripts/install-ios-simulator.sh",
    "ios:simulator": "./scripts/install-ios-simulator.sh",
    "ios:device": "./scripts/install-ios-device.sh",
    "test": "jest --watchAll",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "expo": "~52.0.0",
    "expo-router": "~4.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-paper": "^5.12.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.3.0",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-reanimated": "~3.16.1",
    "expo-status-bar": "~2.0.0",
    "expo-font": "~13.0.1",
    "expo-linking": "~7.0.3",
    "expo-constants": "~17.0.3",
    "expo-secure-store": "~14.0.0",
    "expo-notifications": "~0.29.9",
    "expo-device": "~7.0.1",
    "expo-location": "~18.0.4",
    "expo-camera": "~16.0.9",
    "expo-document-picker": "~12.0.2",
    "expo-haptics": "~14.0.0",
    "expo-image": "~2.0.1",
    "expo-splash-screen": "~0.29.18",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@tanstack/react-query": "^5.61.0",
    "axios": "^1.7.9",
    "zustand": "^5.0.1",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@expo-google-fonts/space-grotesk": "^0.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~18.3.12",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.4.5",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0"
  }
}
