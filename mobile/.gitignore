# Git ignore for mobile (Expo / React Native)
# Keep `app/` and `src/` in source control — do NOT ignore them.

# Node dependencies
node_modules/

# Expo and Metro caches/build outputs
.expo/
.expo-shared/
.expo/cache/
.expo/web/
.expo/*.jks

# Build artifacts (do not ignore source `app/` or `src/`)
.build/
build/
dist/

# Android build / gradle
android/.gradle/
android/app/build/
android/build/
.gradle/

# iOS build / Xcode / CocoaPods
ios/build/
ios/Pods/
Pods/
*.xcworkspace
xcuserdata/
*.xcuserstate
*.xcodeproj/project.xcworkspace/

# macOS artifacts
.DS_Store

# Keystore / signing files
*.jks
*.keystore

# Environment files (do not check secrets into git)
.env
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE/editor folders
.vscode/
.idea/

# Fastlane
fastlane/report.xml
fastlane/Preview.html

# Misc temp files
*.tmp
*.temp

# Optional: uncomment if you use these local files
# ios/TransportPlatform/fastlane/report.xml
# android/local.properties