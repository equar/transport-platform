# Git ignore for mobile (Expo / React Native)
# Keep `app/` and `src/` in source control — do NOT ignore them.

# Node dependencies
node_modules/

# Expo and Metro caches/build outputs
.expo/
.expo-shared/
.expo/cache/
.expo/web/
.expo/*.jks

# Build artifacts (do not ignore source `app/` or `src/`)
.build/
build/
dist/
artifacts/

# Native projects are regenerated via `npx expo prebuild` — do not track them.
/android/
/ios/

# macOS artifacts
.DS_Store

# Keystore / signing files
*.jks
*.keystore

# Environment files (do not check secrets into git)
.env
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE/editor folders
.vscode/
.idea/

# Fastlane
fastlane/report.xml
fastlane/Preview.html

# Misc temp files
*.tmp
*.temp

