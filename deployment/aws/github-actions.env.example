# Copy to ignored github-actions.env. Values are literal, not shell expressions.
# Required SSH secrets. Verify the known_hosts entry/fingerprint out of band.
LIGHTSAIL_HOST=REPLACE_WITH_TRANSPORT_HOST
LIGHTSAIL_USER=ubuntu
LIGHTSAIL_SSH_KEY_B64=REPLACE_WITH_BASE64_PRIVATE_KEY
LIGHTSAIL_KNOWN_HOSTS=REPLACE_WITH_VERIFIED_KNOWN_HOSTS_LINE

# Existing private MySQL database; use a transport-scoped application identity.
MYSQL_HOST=REPLACE_WITH_DATABASE_DNS_HOST
MYSQL_PORT=3306
MYSQL_DATABASE=transport_platform
MYSQL_USER=transport
MYSQL_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
APP_SECURITY_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

APP_PUBLIC_URL=https://transport.bakaroo.com
APP_ADMIN_URL=https://admin.transport.bakaroo.com
VITE_API_BASE_URL=/api
APP_SECURITY_ALLOWED_ORIGINS=https://transport.bakaroo.com,https://admin.transport.bakaroo.com
APP_AUTH_PASSWORD_RESET_BASE_URL=https://admin.transport.bakaroo.com/reset-password
# Optional browser Google Maps key; restrict its HTTP referrers and enabled APIs.
VITE_GOOGLE_MAPS_API_KEY=

# Enable only for deliberate first-admin setup; disable/remove password afterwards.
# Enable email bootstrap only with real email delivery configured.
APP_BOOTSTRAP_PLATFORM_ADMIN_EMAIL_ENABLED=true
APP_BOOTSTRAP_PLATFORM_ADMIN_EMAILS=apps@bakaroo.com,equarhishe@gmail.com
APP_BOOTSTRAP_PLATFORM_ADMIN_ENABLED=false
APP_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=
APP_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=

# Production requires working delivery credentials. Preflight rejects disabled/logging providers.
APP_EMAIL_ENABLED=true
APP_EMAIL_PROVIDER=microsoft-graph
APP_EMAIL_FROM=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
APP_PUSH_ENABLED=true
APP_PUSH_PROVIDER=expo
APP_PUSH_EXPO_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=

APP_LOGGING_LEVEL_ROOT=INFO
APP_LOGGING_LEVEL_APP=INFO
APP_LOGGING_LEVEL_WEB=WARN
APP_LOGGING_LEVEL_SECURITY=INFO
APP_LOGGING_LEVEL_SQL=WARN
APP_LOGGING_LEVEL_SQL_BIND=OFF

# Generate once with: openssl rand -base64 32. Back up securely; changing loses enrolled MFA secrets.
APP_SECURITY_MFA_ENCRYPTION_KEY=
# Enable after privileged users have enrolled and saved recovery codes.
APP_AUTH_REQUIRE_MFA_FOR_PRIVILEGED_ACCOUNTS=false
