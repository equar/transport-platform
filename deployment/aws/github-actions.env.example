# Copy to github-actions.env, fill the placeholders, and keep that file private.
LIGHTSAIL_SSH_KEY_B64=REPLACE_WITH_BASE64_PRIVATE_KEY
LIGHTSAIL_HOST=44.204.49.94
LIGHTSAIL_USER=ubuntu

MYSQL_HOST=REPLACE_WITH_RDS_HOST
MYSQL_PORT=3306
MYSQL_DATABASE=transport_platform
MYSQL_USER=admin
MYSQL_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD

SERVER_PORT=8087
FRONTEND_PORT=3007
APP_PUBLIC_URL=https://transport.bakaroo.com
APP_SECURITY_ALLOWED_ORIGINS=https://transport.bakaroo.com
APP_SECURITY_JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
APP_BOOTSTRAP_PLATFORM_ADMIN_ENABLED=true
APP_BOOTSTRAP_PLATFORM_ADMIN_EMAIL=REPLACE_WITH_PLATFORM_ADMIN_EMAIL
# Required only when the configured platform admin account is absent.
APP_BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=REPLACE_WITH_AT_LEAST_20_CHARACTER_BOOTSTRAP_PASSWORD
APP_LOGGING_LEVEL_ROOT=INFO
APP_LOGGING_LEVEL_APP=DEBUG
APP_LOGGING_LEVEL_WEB=DEBUG
APP_LOGGING_LEVEL_SECURITY=INFO
APP_LOGGING_LEVEL_SQL=INFO
APP_LOGGING_LEVEL_SQL_BIND=INFO

APP_EMAIL_ENABLED=true
APP_EMAIL_PROVIDER=microsoft-graph
APP_EMAIL_FROM=REPLACE_WITH_MICROSOFT_365_SENDER
MICROSOFT_GRAPH_CLIENT_ID=REPLACE_WITH_GRAPH_CLIENT_ID
MICROSOFT_GRAPH_TENANT_ID=REPLACE_WITH_GRAPH_TENANT_ID
MICROSOFT_GRAPH_CLIENT_SECRET=REPLACE_WITH_GRAPH_CLIENT_SECRET
APP_PUSH_ENABLED=true
APP_PUSH_PROVIDER=expo
APP_PUSH_EXPO_URL=https://exp.host/--/api/v2/push/send
EXPO_ACCESS_TOKEN=REPLACE_WITH_EXPO_ACCESS_TOKEN
