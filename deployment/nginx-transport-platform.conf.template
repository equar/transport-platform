# Render only ${APP_DOMAIN} and ${ADMIN_DOMAIN}; preserve all Nginx runtime variables.
map "$status:$uri" $transport_cache_control {
    default "no-store";
    ~^(200|304):/assets/ "public, max-age=31536000, immutable";
}
server {
    listen 80;
    listen [::]:80;
    server_name ${APP_DOMAIN} ${ADMIN_DOMAIN};
    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${APP_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/transport-platform/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/transport-platform/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    root /var/www/transport-platform/public;
    index index.html;
    client_max_body_size 11m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), geolocation=(self), microphone=()" always;
    add_header Cache-Control $transport_cache_control always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; upgrade-insecure-requests" always;
    location = /health { access_log off; default_type text/plain; return 200 "healthy\n"; }
    location = /api { return 308 /api/; }
    location = /api/actuator/health {
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /api/actuator/ { return 404; }
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 120s;
    }
    location /assets/ { try_files $uri @transport_previous_asset; }
    location @transport_previous_asset { root /var/www/transport-platform.previous; try_files /public$uri $uri =404; }
    location /branding/ { try_files $uri =404; }
    location = /release.json { root /var/www/transport-platform; try_files $uri =404; }
    # Terminate the SPA fallback if no frontend has been deployed yet.
    location = /index.html { try_files $uri =404; }
    # Old account links move to the authenticated application, preserving queries.
    location ~ ^/(login|forgot-password|reset-password|unauthorized|platform|company|portal)(/|$) {
        return 302 https://${ADMIN_DOMAIN}$request_uri;
    }
    location / { try_files $uri $uri/ /index.html; }
    location ~ /\. { deny all; }
}
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${ADMIN_DOMAIN};
    ssl_certificate /etc/letsencrypt/live/transport-platform/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/transport-platform/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    add_header X-Robots-Tag "noindex, nofollow" always;
    location = /robots.txt { default_type text/plain; return 200 "User-agent: *\nDisallow: /\n"; }
    root /var/www/transport-platform/admin;
    index index.html;
    client_max_body_size 11m;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), geolocation=(self), microphone=()" always;
    add_header Cache-Control $transport_cache_control always;
    add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self'; upgrade-insecure-requests" always;
    location = /health { access_log off; default_type text/plain; return 200 "healthy\n"; }
    location = /api { return 308 /api/; }
    location = /api/actuator/health {
        proxy_pass http://127.0.0.1:8082;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /api/actuator/ { return 404; }
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:8082;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 120s;
    }
    location /assets/ { try_files $uri @transport_previous_asset; }
    location @transport_previous_asset { root /var/www/transport-platform.previous; try_files /admin$uri =404; }
    location /branding/ { try_files $uri =404; }
    location = /release.json { root /var/www/transport-platform; try_files $uri =404; }
    # Terminate the SPA fallback if no frontend has been deployed yet.
    location = /index.html { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
    location ~ /\. { deny all; }
}
